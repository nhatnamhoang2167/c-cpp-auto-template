{
  "name": "c-auto-template",
  "displayName": "C/C++ Auto Template",
  "description": "Automatically inserts a C/C++ template when creating or opening an empty .c/.cpp file.",
  "publisher": "nhatnam7kz",
  "author": "Nhat Nam",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nhatnamhoang2167/c-cpp-auto-template"
  },
  "license": "MIT",
  "version": "1.0.8",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "C/C++ Auto Template",
      "properties": {

        "ccAutoTemplate.enableCPTemplate": {
          "type": "boolean",
          "default": false,
          "description": "Enable Competitive Programming template (#include <bits/stdc++.h>). When enabled, custom C++ libraries will be ignored."
        },

        "ccAutoTemplate.cppLibraries": {
          "type": "array",
          "description": "Select C++ libraries to include in the template",
          "items": {
            "type": "string",
            "enum": [
              "iostream",
              "vector",
              "string",
              "cmath",
              "algorithm",
              "map",
              "set"
            ]
          },
          "default": [
            "iostream"
          ],
          "uniqueItems": true
        },

        "ccAutoTemplate.cLibraries": {
          "type": "array",
          "description": "Select C libraries to include in the template",
          "items": {
            "type": "string",
            "enum": [
              "stdio.h",
              "stdlib.h",
              "math.h",
              "string.h",
              "time.h"
            ]
          },
          "default": [
            "stdio.h"
          ],
          "uniqueItems": true
        }

      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/node": "22.x",
    "typescript": "^5.9.3"
  }
}